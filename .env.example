# Execution Mode
PAPER_TRADING=true

# Capital & Strict Risk Management
TRADING_CAPITAL=50000
MAX_RISK_PCT=0.01
RISK_REWARD_RATIO=2.0
MAX_TRADES_PER_DAY=1
MAX_LEVERAGE=1.0
SLIPPAGE_BPS=5.0

# Strategy Filters
MIN_RVOL=1.5

# State Persistence (local | s3)
STATE_BACKEND=local
STATE_FILE_PATH=state
S3_STATE_BUCKET=
S3_STATE_PREFIX=state

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live Broker Credentials (Required only when PAPER_TRADING=false)
BROKER_API_KEY=
BROKER_ACCESS_TOKEN=
BROKER_BASE_URL=https://api.kite.trade
